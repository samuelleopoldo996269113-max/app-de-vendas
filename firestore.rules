rules_version = '2';

// Regras de segurança do banco de dados.
// Copie este arquivo inteiro em: Firebase > Firestore Database > Regras > Publicar.
// TROQUE o e-mail abaixo pelo mesmo e-mail que está em js/firebase-config.js (ADMIN_EMAIL).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() == 'email.da.loja@exemplo.com';
    }
    function logado() { return request.auth != null; }

    // Produtos: todo mundo vê, só a loja altera
    match /produtos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Nome da loja, WhatsApp, textos: todo mundo vê, só a loja altera
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cadastro da cliente: só ela mesma e a loja
    match /clientes/{uid} {
      allow read, write: if logado() && (request.auth.uid == uid || isAdmin());
    }

    // Pedidos: a cliente cria e vê os dela; só a loja muda status
    match /pedidos/{id} {
      allow create: if logado()
        && request.resource.data.clienteId == request.auth.uid
        && request.resource.data.status == 'recebido'
        && request.resource.data.pago == false
        && request.resource.data.estoqueBaixado == false;
      allow read: if logado() && (resource.data.clienteId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
